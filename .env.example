# =============================================================================
# MultiSchool Platform — Environment Variables (ROOT REFERENCE COPY)
# =============================================================================
# This file lives at the project root for documentation/discovery ONLY.
# The apps do NOT read a root `.env` — copy the right file(s) instead:
#
#   Backend (REQUIRED) : cp backend/.env.example backend/.env
#                        Windows (PS): Copy-Item backend\.env.example backend\.env
#   Frontend (OPTIONAL): cp frontend/.env.example frontend/.env
#
# Canonical templates (kept in sync with the code — prefer those):
#   - backend/.env.example   → every backend variable, read by backend/src/config/env.ts
#   - frontend/.env.example  → no mandatory variables; dev API uses the Vite proxy
#
# Rules:
#   1. NEVER commit a real `.env` to Git (already in .gitignore).
#   2. NEVER put secrets in the frontend or any `VITE_*` variable.
#   3. Restart the backend after changing `backend/.env`.
#   4. Generate secrets: openssl rand -hex 32
#      or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Full documentation: README.md → "Environment Variables"
# =============================================================================

# ---------------------------------------------------------------------------
# Backend — copy ALL of the following into `backend/.env`
# ---------------------------------------------------------------------------

# App
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database — MySQL 8 (create the database first, see README → Quick Start)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change-me
DB_DATABASE=multySchoolsPlatform

# JWT — two different random secrets, at least 32 chars (required in production)
JWT_SECRET=change-me-at-least-32-random-characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-a-different-at-least-32-random-characters
JWT_REFRESH_EXPIRES_IN=30d

# Field encryption — AES-256-GCM (mandatory in production: openssl rand -hex 32)
ENCRYPTION_KEY=
# ENCRYPTION_KEY_ID=k1
# ENCRYPTION_KEYS={"k1":"<64-hex>","k0":"<previous-64-hex>"}

# HTTP / proxy / cookies
TRUST_PROXY=false
# HSTS_PRELOAD=false
# AUTH_COOKIE_SAMESITE=lax
# AUTH_SESSION_CACHE_MS=30000

# Redis (optional — server runs without cache if Redis is down)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Scheduled jobs
# NOTIFICATION_CLEANUP_CRON=0 2 * * *
# NOTIFICATION_CLEANUP_TZ=Africa/Algiers

# Seed (first run only — npm run seed)
# SUPER_ADMIN_INITIAL_PASSWORD=
# SUPER_ADMIN_PHONE=0555000000

# AI — Meta Model API (optional, backend ONLY; heuristic fallback when unset)
# META_AI_API_KEY=
# META_AI_BASE_URL=https://api.meta.ai/v1
# META_AI_MODEL=muse-spark-1.3
# META_AI_VISION_MODEL=muse-spark-1.3
# AI_REQUEST_TIMEOUT_MS=30000
# AI_AUTO_APPROVE_SCHEDULE=false
# SAM_API_URL=https://api.meta.ai/v1
# SAM_API_KEY=
# SAM_MODEL=sam-3.1
# DOCUMENT_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Frontend — copy the following into `frontend/.env` ONLY if needed
# (no mandatory variables; NEVER add secrets / VITE_* keys)
# ---------------------------------------------------------------------------
# PORT=5173
# E2E_BASE_URL=http://127.0.0.1:4173
