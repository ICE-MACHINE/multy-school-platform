{
  "name": "multyschool-backend",
  "version": "1.0.0",
  "description": "MultiSchool Platform Backend - Microservices Architecture",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm migration:generate -d src/config/data-source.ts",
    "migration:run": "npm run typeorm migration:run -d src/config/data-source.ts",
    "migration:revert": "npm run typeorm migration:revert -d src/config/data-source.ts",
    "seed": "ts-node -r tsconfig-paths/register src/database/seeds/seed.ts",
    "test:scheduling": "ts-node --transpile-only -r tsconfig-paths/register src/modules/timetable/scheduling/constraintEngine.test.ts",
    "test:documents": "ts-node --transpile-only -r tsconfig-paths/register src/modules/ai/documentFileValidation.test.ts && ts-node --transpile-only -r tsconfig-paths/register src/modules/ai/documentVerification.test.ts",
    "test:bi": "ts-node --transpile-only -r tsconfig-paths/register src/modules/ai/businessIntelligence.test.ts",
    "test:tenant": "ts-node --transpile-only -r tsconfig-paths/register src/shared/tenant/tenantScope.test.ts",
    "test:intelligence": "ts-node --transpile-only -r tsconfig-paths/register src/modules/ai/intelligenceEngines.test.ts",
    "test:lifecycle": "ts-node --transpile-only -r tsconfig-paths/register src/modules/ai/documentLifecycle.test.ts",
    "test:integration": "ts-node --transpile-only -r tsconfig-paths/register tests/integration/api.e2e.test.ts",
    "test:all": "npm run typecheck && npm run test:scheduling && npm run test:documents && npm run test:lifecycle && npm run test:bi && npm run test:tenant && npm run test:intelligence && npm run test:security && npm run test:integration",
    "security:re-encrypt-legacy": "ts-node -r tsconfig-paths/register src/scripts/reEncryptLegacyMessages.ts",
    "test:security": "ts-node --transpile-only -r tsconfig-paths/register src/shared/auth/authSecurity.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "node-cron": "^4.6.0",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.7.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.20",
    "uuid": "^10.0.0",
    "winston": "^3.14.2",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/hpp": "^0.2.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.5.0",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  }
}
