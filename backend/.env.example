# =============================================================================
# MultiSchool Platform — Backend Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in your real values:
#
#   Linux / macOS : cp .env.example .env
#   Windows (PS)  : Copy-Item .env.example .env
#
# - NEVER commit the real `.env` file to Git (it is already in .gitignore).
# - NEVER share it in chats, screenshots, or issues.
# - Restart the backend after every change (env is read once at boot).
# - Generate strong secrets with:
#     openssl rand -hex 32
#   or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================================================


# -----------------------------------------------------------------------------
# 1) App (required)
# -----------------------------------------------------------------------------
# development | production
# NOTE: production disables TypeORM `synchronize`, requires JWT/encryption
# secrets below, and refuses to boot while migrations are pending.
NODE_ENV=development

# API server port (health check: http://localhost:5000/health)
PORT=5000

# Frontend origin(s) allowed by CORS — must match the real website origin.
# Comma-separate multiple origins. Dev website (Vite) runs on 5173.
FRONTEND_URL=http://localhost:5173


# -----------------------------------------------------------------------------
# 2) Database — MySQL 8 (required)
# Create it first:
#   CREATE DATABASE multySchoolsPlatform CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change-me
DB_DATABASE=multySchoolsPlatform


# -----------------------------------------------------------------------------
# 3) JWT / Auth tokens (required — secrets are MANDATORY in production)
# Use two DIFFERENT random secrets of at least 32 characters each.
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-at-least-32-random-characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-a-different-at-least-32-random-characters
JWT_REFRESH_EXPIRES_IN=30d

# Auth cookie SameSite policy (backend/src/shared/auth/authCookies.ts):
#   lax    = same-site (default; incl. via proxy)
#   none   = cross-site API — REQUIRES HTTPS
#   strict = same-site only
# AUTH_COOKIE_SAMESITE=lax

# Session-state (token revocation) in-process cache TTL, milliseconds.
# AUTH_SESSION_CACHE_MS=30000


# -----------------------------------------------------------------------------
# 4) Field encryption — AES-256-GCM (MANDATORY in production)
# Generate: openssl rand -hex 32
# Set a STABLE key BEFORE writing encrypted data: changing it afterwards
# (or rotating JWT_SECRET while this is unset) makes old data undecryptable.
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=

# Key rotation (optional): new writes use ENCRYPTION_KEY_ID; all listed keys
# stay readable. Example:
# ENCRYPTION_KEY_ID=k1
# ENCRYPTION_KEYS={"k1":"<64-hex-current>","k0":"<64-hex-previous>"}


# -----------------------------------------------------------------------------
# 5) HTTP / Proxy / HSTS
# -----------------------------------------------------------------------------
# Enable ONLY behind exactly one trusted reverse proxy, otherwise
# rate limiting can be spoofed via X-Forwarded-For.
TRUST_PROXY=false

# Enable ONLY after EVERY subdomain serves HTTPS (preload is hard to undo).
# HSTS_PRELOAD=false


# -----------------------------------------------------------------------------
# 6) Redis (optional — the server runs without cache if Redis is down)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=


# -----------------------------------------------------------------------------
# 7) Rate limiting (general limiter; auth/write/upload/AI have own limits)
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100


# -----------------------------------------------------------------------------
# 8) Scheduled jobs
# Notification cleanup runs daily at 02:00 Africa/Algiers by default.
# -----------------------------------------------------------------------------
# NOTIFICATION_CLEANUP_CRON=0 2 * * *
# NOTIFICATION_CLEANUP_TZ=Africa/Algiers


# -----------------------------------------------------------------------------
# 9) Seed — FIRST RUN ONLY (npm run seed)
# If SUPER_ADMIN_INITIAL_PASSWORD is unset, a random one is generated and
# printed EXACTLY ONCE in the seed output — save it immediately.
# Password policy: minimum 12 characters. First login forces a change.
# -----------------------------------------------------------------------------
# SUPER_ADMIN_INITIAL_PASSWORD=
# SUPER_ADMIN_PHONE=0555000000


# -----------------------------------------------------------------------------
# 10) AI — Meta Model API (OPTIONAL — deterministic heuristic fallback
#     is used when unset; the platform works fully without any AI key)
# Official docs: Base URL https://api.meta.ai/v1, Auth: Bearer MODEL_API_KEY
# !!! BACKEND ONLY — never put this key in the frontend / any VITE_* var !!!
# -----------------------------------------------------------------------------
# META_AI_API_KEY=
# LLAMA_API_KEY=            # supported alias for META_AI_API_KEY
# META_AI_BASE_URL=https://api.meta.ai/v1
# META_AI_MODEL=muse-spark-1.3
# META_AI_VISION_MODEL=muse-spark-1.3
# AI_REQUEST_TIMEOUT_MS=30000

# Fully automatic approval of conflict-free teacher schedule changes.
# Default false = AI evaluates + recommends, an admin approves manually.
# AI_AUTO_APPROVE_SCHEDULE=false

# SAM 3.1 segmentation — served by the same Meta Model API (Responses API)
# with the same key. Segmentation ONLY; it never justifies an absence.
# SAM_API_URL=https://api.meta.ai/v1
# SAM_API_KEY=
# SAM_MODEL=sam-3.1

# Encryption key for uploaded AI documents (AES-256-GCM at rest).
# Generate: openssl rand -hex 32
# !!! Set BEFORE the first upload — changing it later makes old files
#     undecryptable !!!
# DOCUMENT_ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# 11) One-time legacy migration tool ONLY (npm run security:re-encrypt-legacy)
# Historical CBC key material, supplied by the operator for that single run,
# then deleted together with the script. Do NOT set for normal operation.
# -----------------------------------------------------------------------------
# LEGACY_CBC_SECRET=
# LEGACY_CBC_SALT=
