# =============================================================================
# MultiSchool Platform — Frontend Environment Variables
# =============================================================================
# Copy this file to `.env` if you need any of the OPTIONAL variables below:
#
#   Linux / macOS : cp .env.example .env
#   Windows (PS)  : Copy-Item .env.example .env
#
# GOOD NEWS: the frontend needs NO mandatory variable in development.
# API requests go to `/api` and Vite proxies them to the backend at
# http://localhost:5000 (see `vite.config.ts`). Just run `npm run dev`.
#
# !!! SECURITY WARNING !!!
# - NEVER put secrets (API keys, passwords, JWT secrets, Meta AI keys...)
#   in this file or in ANY variable prefixed with `VITE_`. Everything in
#   the frontend bundle is publicly readable in the browser.
# - All secrets belong in `backend/.env` ONLY.
# - Real `.env` files are git-ignored — never commit them.
# =============================================================================


# -----------------------------------------------------------------------------
# Optional — production static server (server.mjs)
# Port used when serving the production build manually: `node server.mjs`
# (default: 5173). Not used by `npm run dev` / `npm run preview`.
# -----------------------------------------------------------------------------
# PORT=5173


# -----------------------------------------------------------------------------
# Optional — E2E tests (Playwright, playwright.config.ts)
# By default `npm run test:e2e` builds the app and serves `npm run preview`
# on http://127.0.0.1:4173. Set this only to test an already-running server.
# -----------------------------------------------------------------------------
# E2E_BASE_URL=http://127.0.0.1:4173


# -----------------------------------------------------------------------------
# Reference only — variables that intentionally do NOT exist here
# -----------------------------------------------------------------------------
# (do not add — listed so you don't go looking for them)
#
#   VITE_API_URL        Not used: the app calls relative `/api`, proxied
#                       by Vite in dev and by your reverse proxy in prod.
#   VITE_META_AI_*      Forbidden: AI keys are backend-only secrets.
#   Any VITE_* secret   Forbidden: exposed to every visitor's browser.
